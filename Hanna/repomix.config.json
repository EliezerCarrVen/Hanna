{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false
  },
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      ".vs/**",
      "**/bin/**",
      "**/obj/**",
      "**/.git/**",
      "**/node_modules/**",
      "**/pruebas_voces_hanna/**",
      "**/*.mp3",
      "**/*.wav",
      "**/*.mp4",
      "**/*.mpack",
      "**/*.db",
      "**/*.cache",
      "**/*.suo",
      "**/*.user",
      "**/registros_conversacion/**",
      "**/spotify_tokens/**",
      "**/spotify_refresh_token.txt",
      "**/HannaEnv.env"
    ]
  }
}
