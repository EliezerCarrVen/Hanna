{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hanna Skill Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "intents",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}