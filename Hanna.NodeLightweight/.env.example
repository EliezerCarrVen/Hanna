# Copia este archivo a .env solo en la máquina local. No lo subas a git.
# La versión Node puede arrancar sin .NET ni secretos.
HANNA_DATA_DIR=../HannaData
HANNA_DRY_RUN=true
HANNA_ACTIVE_USER=local-root
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
HANNA_TELEGRAM_DRY_RUN=false
HANNA_NAS_ALLOWLIST=
HANNA_MQTT_BROKER_URL=
HANNA_MQTT_CLIENT_ID=hanna-node-lightweight
HANNA_NODE_RED_URL=http://127.0.0.1:1880
HANNA_ALLOW_DEPLOY=false
HANNA_VAULT_PASSWORD=
HANNA_TOTP_SECRET=
HANNA_ENGINE=local-node
HANNA_PHASE=node-lightweight

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_REFRESH_TOKEN=
HANNA_SPOTIFY_DRY_RUN=true
